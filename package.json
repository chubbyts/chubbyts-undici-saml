{
  "name": "@chubbyts/chubbyts-undici-saml",
  "type": "module",
  "version": "1.0.0",
  "description": "A small SAML 2.0 service provider (Web Browser SSO and Single Logout) for chubbyts-undici-server.",
  "keywords": [
    "saml",
    "saml2",
    "sso",
    "service-provider",
    "assertion",
    "middleware",
    "undici"
  ],
  "author": "Dominik Zogg",
  "license": "MIT",
  "repository": "chubbyts/chubbyts-undici-saml",
  "scripts": {
    "build": "rm -Rf dist && tsc",
    "cs-fix": "prettier --write src tests",
    "cs": "prettier --check src tests",
    "infection": "stryker run",
    "lint-fix": "oxlint --fix src tests vitest.config.ts vitest.integration.config.ts",
    "lint": "oxlint src tests vitest.config.ts vitest.integration.config.ts",
    "prepare": "pnpm run build",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test": "vitest"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./*.d.ts",
      "import": "./*.js",
      "default": "./*.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@chubbyts/chubbyts-dic-config-factory": "^1.0.1",
    "@chubbyts/chubbyts-dic-types": "^2.3.1",
    "@chubbyts/chubbyts-log-types": "^3.3.1",
    "@chubbyts/chubbyts-undici-server": "^1.3.1",
    "@node-saml/node-saml": "^5.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@chubbyts/chubbyts-dic-config": "^2.3.1",
    "@chubbyts/chubbyts-function-mock": "^2.3.1",
    "@chubbyts/chubbyts-oxlint": "^1.0.2",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "xml-crypto": "^6.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024"
}
